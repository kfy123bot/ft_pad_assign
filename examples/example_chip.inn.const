( globals
    version = 3
    io_order = default
)
( iopad
    ( left
        ( locals ring_number = 1 )
        ( inst name="u_mck" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="u_msi" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="u_mso" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="VDDC01" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="u_mbs" offset=0 orientation=R0 place_status=fixed spacing=0 )
    )
    ( bottom
        ( locals ring_number = 1 )
        ( inst name="u_mbc" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="VDDIO01" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="VDDIO02" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="u_mbr" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="VSSCIO01" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="u_mrd" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="u_mbo" offset=0 orientation=R0 place_status=fixed spacing=0 )
    )
    ( right
        ( locals ring_number = 1 )
        ( inst name="VSSIO01" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="u_web" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="u_csb" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="POWERCUT01" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="u_d7" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="u_d6" offset=0 orientation=R0 place_status=fixed spacing=0 )
    )
    ( top
        ( locals ring_number = 1 )
        ( inst name="u_d5" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="u_d4" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="VDDIO03" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="u_d3" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="u_d2" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="VSSC01" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="VSSIO02" offset=0 orientation=R0 place_status=fixed spacing=0 )
        ( inst name="u_d1" offset=0 orientation=R0 place_status=fixed spacing=0 )
    )
)
